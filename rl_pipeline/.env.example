# Copy to .env (never commit it) or point `azure.env_file` in your config at an existing file.

# Azure OpenAI / Foundry resource key.
AZURE_OPENAI_API_KEY=

# Either the OpenAI-compatible endpoint ...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# ... or just the resource name (the endpoint is derived from it).
AZURE_AI_RESOURCE=
