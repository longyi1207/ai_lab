# Copy to .env in this directory (research_dojo/.env) and fill in.
# Never commit the real .env — it's gitignored.

# --- Azure OpenAI (preferred) ---
OPENAI_PREFER_AZURE=true
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# --- Direct OpenAI (fallback if Azure vars above are unset) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Optional ---
# DOJO_ALERT_WEBHOOK_URL=
# DOJO_DATABASE_URL=postgresql://dojo:dojo@localhost:5432/dojo
