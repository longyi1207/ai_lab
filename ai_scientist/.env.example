# ai_scientist — environment reference (names only, never commit real values)
# Phase-1 metadata records credential *refs* (these names), not secrets.

# Prefer Azure OpenAI when true and AZURE_* are set (see repo docs/AZURE.md)
OPENAI_PREFER_AZURE=true

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Fallback direct OpenAI
OPENAI_API_KEY=

# Offline / test mode: forces FakeLLM everywhere (no network)
AI_SCIENTIST_FAKE_LLM=0
