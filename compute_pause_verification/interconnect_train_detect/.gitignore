__pycache__/
.venv/
infra/.active/
infra/terraform/.terraform/
infra/terraform/*.tfstate*
infra/terraform/terraform.tfvars
infra/scripts/config.env
infra/azure/.active/
infra/azure/terraform/.terraform/
infra/azure/terraform/*.tfstate*
infra/azure/terraform/terraform.tfvars
infra/azure/scripts/config.env
*.joblib
*.pt
*.jsonl
.DS_Store
.pytest_cache/

# outputs/ is gitignored in the working repo (local scratch state from
# every run, including partial/failed ones) but this published copy
# intentionally includes the curated, final result for every experiment
# cited in docs/REDTEAM.md -- see "Reproducing this" in that doc. Negate
# the *.joblib/*.jsonl excludes above specifically for this directory.
!outputs/**/*.joblib
!outputs/**/*.jsonl
