# ICTD AWS helpers — source this from scripts.
# Copy to config.env and edit (config.env is gitignored).

AWS_REGION="${AWS_REGION:-us-east-1}"
AWS_PROFILE="${AWS_PROFILE:-default}"
SSH_USER="${SSH_USER:-ubuntu}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/YOUR_KEY_PAIR.pem}"
REMOTE_DIR="${REMOTE_DIR:-/home/ubuntu/ictd}"
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ACTIVE_DIR="${PROJECT_ROOT}/infra/.active"
TF_DIR="${PROJECT_ROOT}/infra/terraform"

# Optional overrides if not using terraform outputs:
# NODE0_IP=
# NODE1_IP=
# MASTER_ADDR=
# COLLECTOR_URL=
