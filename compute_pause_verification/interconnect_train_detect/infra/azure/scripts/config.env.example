# ICTD Azure helpers — source this from scripts.
# Copy to config.env and edit (config.env is gitignored, same as the AWS scripts' config.env).

AZURE_SUBSCRIPTION_ID="${AZURE_SUBSCRIPTION_ID:-27ad7138-6e41-4554-9d72-36eb4502b0bb}" # "Azure subscription 1"
AZURE_RESOURCE_GROUP="${AZURE_RESOURCE_GROUP:-IncidentFox}"
AZURE_REGION="${AZURE_REGION:-eastus}"
SSH_USER="${SSH_USER:-azureuser}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_ed25519}"
REMOTE_DIR="${REMOTE_DIR:-/home/azureuser/ictd}"
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
ACTIVE_DIR="${PROJECT_ROOT}/infra/azure/.active"
TF_DIR="${PROJECT_ROOT}/infra/azure/terraform"

# Optional overrides if not using terraform outputs (single node — no rank dance):
# NODE_IP=
# NODE_PRIV_IP=
# COLLECTOR_URL=
